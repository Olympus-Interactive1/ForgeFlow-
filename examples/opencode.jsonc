{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "forgeflow": {
        "type": "remote",
        "url": "http://localhost:8787/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:FORGEFLOW_API_KEY}"
        },
        "timeout": {
          "execution": 600000
        }
      }
    }
  }
}
