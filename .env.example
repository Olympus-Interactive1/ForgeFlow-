# ForgeFlow v0.5.0 runtime
HOST=0.0.0.0
PORT=8787
FORGEFLOW_MCP_PATH=/mcp
FORGEFLOW_API_KEY=change-me
FORGEFLOW_RATE_LIMIT=60
FORGEFLOW_RATE_WINDOW_MS=60000
FORGEFLOW_MAX_BODY_BYTES=2097152
FORGEFLOW_PROVIDER_TIMEOUT_MS=60000

# Hard free-only policy. Keep this true unless you intentionally fork the project.
FORGEFLOW_FREE_ONLY=true
FORGEFLOW_FREE_PROVIDERS=openrouter,google,nvidia
FORGEFLOW_QUALITY_PROVIDERS=google,nvidia,openrouter

# Provider API keys — enter YOUR OWN keys. ForgeFlow never ships shared provider keys.
# OpenRouter free model routing (text/free-tier workloads)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Gemini free-tier models where available
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# NVIDIA Build/NIM free endpoints where available
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# fal.ai is retained as a provider adapter for future/paid opt-in work,
# but v0.5.0 free-only routing will refuse to select it.
FAL_KEY=
FAL_BASE_URL=https://queue.fal.run
