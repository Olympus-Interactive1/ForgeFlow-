# ForgeFlow v0.6.0 runtime
HOST=0.0.0.0
PORT=8787
FORGEFLOW_MCP_PATH=/mcp
FORGEFLOW_API_KEY=change-me
FORGEFLOW_RATE_LIMIT=60
FORGEFLOW_RATE_WINDOW_MS=60000
FORGEFLOW_MAX_BODY_BYTES=2097152
FORGEFLOW_PROVIDER_TIMEOUT_MS=60000

# Hard free-only policy. Keep this true unless you intentionally fork the project.
FORGEFLOW_FREE_ONLY=true
FORGEFLOW_FREE_PROVIDERS=openrouter,google,nvidia
FORGEFLOW_QUALITY_PROVIDERS=google,nvidia,openrouter

# Provider API keys — enter YOUR OWN keys. ForgeFlow never ships shared provider keys.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# NVIDIA Build/NIM free endpoints
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Cosmos3 hosted generator (free endpoint). Override only if NVIDIA changes the catalog URL.
COSMOS3_INFER_URL=https://ai.api.nvidia.com/v1/genai/nvidia/cosmos3-nano

# NVIDIA Magpie TTS hosted invocation endpoint. NVIDIA can change the deployment URL;
# leave blank until you copy the current invocation URL from the NVIDIA model API page.
NVIDIA_TTS_BASE_URL=
NVIDIA_TTS_FUNCTION_ID=

# fal.ai is retained as an adapter but is blocked by the default free-only policy.
FAL_KEY=
FAL_BASE_URL=https://queue.fal.run
